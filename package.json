{
  "name": "tinner-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:backend": "pnpm --filter @tinner/backend start:dev",
    "dev:mobile": "pnpm --filter @tinner/mobile start",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f backend postgres",
    "deploy:render:validate": "docker compose build backend",
    "deploy:apk": "pnpm --filter @tinner/mobile apk:build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "docs:build": "cd latex && pdflatex -interaction=nonstopmode main.tex"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5",
      "react": "19.1.0",
      "react-dom": "19.1.0"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3"
  }
}
