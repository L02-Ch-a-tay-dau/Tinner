{
  "expo": {
    "name": "Tinner",
    "slug": "tinner-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "hcmut-after-graduate"
        }
      ],
      "@sentry/react-native",
      "expo-asset"
    ],
    "extra": {
      "apiBaseUrl": "use EXPO_PUBLIC_API_BASE_URL from .env"
    }
  }
}
